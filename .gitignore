# secrets
.env
.env.*
!.env.example
# demo 專用 env 範本（零祕密，僅記錄形狀）：範本可提交，實體 .env.demo 仍被上面的 .env.* 忽略。
!.env.demo.example

# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
build/
coverage/

# local logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# .claude
.claude/settings.json

# local code index
.codegraph/

# 工具快取：tsc 增量建置資訊與 Vite 的依賴預打包快取（皆可重建，且內容因機器而異）
*.tsbuildinfo
.vite/

# Stryker 變異測試：sandbox 暫存目錄與報告輸出（皆可重建）
/.stryker-tmp/
/reports/

# 013 截圖劇本輸出（apps/web/scripts/screenshots.cjs --viewports；可重建，不入 git）
apps/web/.screenshots/

# impeccable 決策頁 session 紀錄與 hook 快取（不入 git；設計工件 surfaces/、critique/、design.json、選定草圖 assigned.html 仍追蹤）
apps/web/.impeccable/questions/
apps/web/.impeccable/hook.cache.json
