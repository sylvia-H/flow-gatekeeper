{
  "name": "flow-gatekeeper",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint eslint.config.js && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @flow-gatekeeper/contracts --filter @flow-gatekeeper/shared build",
    "contract:lint": "spectral lint asyncapi.yaml",
    "check": "pnpm contract:lint && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@types/node": "~22",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "@nestjs/core",
      "protobufjs"
    ]
  }
}
