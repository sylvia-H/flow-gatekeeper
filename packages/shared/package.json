{
  "name": "@flow-gatekeeper/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logging": {
      "development": "./src/logging/index.ts",
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
