# apps/worker/.env.example
# 複製為 apps/worker/.env 後填值：  Copy-Item apps/worker/.env.example apps/worker/.env
# apps/worker/.env 已被 .gitignore 忽略，勿提交（憲章硬規則 7：只提交 .env.example）。
#
# 這支 process = 獨立的 BullMQ consumer：讀 Mongo 組 context → 查 Redis 快取 →
# 取去重鎖 → 呼叫 Gemini streaming → schema 驗證 → 寫 Mongo/快取 → 經 Pub/Sub relay 回 Gateway。
# 啟動時以 Zod 驗證本檔所有變數（src/lib/env-schema.ts）：留空＝用預設值；不合法（非正整數、超出範圍、
# 鎖 TTL 短於 AI 逾時 + 5 秒餘裕）則立即 exit 1，而不是帶著錯設定啟動。
# worker 用 dotenv/config 以「執行時 cwd（apps/worker）」載入本層 .env。
# worker 是唯一呼叫 LLM 的 process，GEMINI_API_KEY 只需放在這裡。

# ---- Redis：BullMQ consumer、cache-aside、dedupe lock、Pub/Sub ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis requirepass；留空＝未啟用密碼。必須與 api 設同一個值。
# redis 伺服端是否啟用認證由 compose 決定（讀 host shell 或 repo 根 .env 的 REDIS_PASSWORD）。
#   啟用密碼時三處 MUST 一致：① host shell 或 repo 根 .env（compose 插值，決定 redis 伺服端是否 --requirepass）、
#   ② apps/api/.env.demo（demo；開發模式為 apps/api/.env）、③ apps/worker/.env。
#   只設 ②③ 而 ① 沒設 → redis 未啟用認證，api／worker 對無密碼 Redis 送 AUTH 被拒；
#   反之 ① 有值（含 shell 裡殘留的同名全域變數）而 ②③ 留空 → redis 悄悄啟用認證，api／worker 全部 NOAUTH。
REDIS_PASSWORD=
# cache／pub 一般指令逾時（毫秒）：Redis 斷線時命令在此時間內 reject，job 才會走錯誤與重試路徑
REDIS_COMMAND_TIMEOUT_MS=5000

# ---- 實例識別（可選）----
# 組成本實例的 Redis key：worker:heartbeat:<id>（healthcheck 只看自己的）、metrics:worker:<id>
# （api 以 SCAN 掃 metrics:worker:* 合併各實例）。留空＝使用 hostname——容器內即 container id，
# 天然唯一，compose／多副本部署不需設定。僅在同一台機器直跑多個 worker 時才需手動設成不同值。
# 只允許英數字與 . _ -（最長 128），不合法則啟動失敗。
# 容器內會被 compose 覆寫為空、改用 hostname——避免多副本共用本檔時撞同一 id、又回到單一 key 的問題。
WORKER_INSTANCE_ID=

# ---- MongoDB：讀近期遙測/errorlogs/maintenance 組 context；寫最終 diagnoses ----
# 資料庫名以 MONGO_DB 為準（MONGO_URL 路徑中的 db 名不會被用來選庫）；須與 apps/api/.env 一致。
MONGO_URL=mongodb://127.0.0.1:27017/flow-gatekeeper
MONGO_DB=flow-gatekeeper

# ---- AI provider（Gemini，包在 AiProvider interface 後）----
# 申請一組 Gemini API key 貼在等號後（不要引號、不要空白）。
# 連通性可先用 pnpm --filter worker smoke:gemini 驗證。
#
# 留空的行為（刻意設計，非缺陷）：
#   症狀——全棧仍照常啟動，遙測與背壓比值正常（4 個賣點中的 2 個仍可見）；僅 AI 診斷失敗，
#         畫面訊息會「指名金鑰」（AI 服務金鑰無效或未授權——請確認本檔的 GEMINI_API_KEY…）。
#   成因——任何環境（含 compose demo）都刻意允許留空，啟動時只記一則 warn，讓沒有 Gemini 帳號的
#         評估者仍看得到系統跑起來，而非一個賣點都看不到。
#   代價——缺席時每筆 AI 診斷立即失敗、不重試（不會白等 3 次退避）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 每分鐘「實際 LLM 呼叫」上限：取得去重鎖且 cache 仍未命中、真的要打 LLM 時才計數（Redis 固定窗），
# cache 命中、等待他人結果的 job 與限流延後都不吃額度。超過上限的 job 延後到下一分鐘（不消耗重試次數）。
AI_RPM=8
# 同時處理的 job 數（BullMQ concurrency）
WORKER_CONCURRENCY=2
# 診斷快取有效期（秒）
AI_CACHE_TTL_SECONDS=600
# 同簽章去重鎖有效期（秒）——持鎖者逾時/崩潰後可放行重算。
# 必須 AI_DEDUPE_LOCK_SECONDS × 1000 ≥ AI_TIMEOUT_MS + 5000（5 秒收尾餘裕，否則啟動失敗）：持鎖期間
# 除了 LLM 串流還要 parse、寫 Mongo、寫 cache；鎖若在這之前過期，等待者會再打一次 LLM，去重失效。
# 預設 45 秒對 30 秒逾時綽綽有餘；調高 AI_TIMEOUT_MS 時記得一併調高本值。
# 5 秒餘裕只涵蓋正常路徑：Mongo／Redis 變慢（例如寫入逼近 socketTimeout）時鎖仍可能先過期、等待者再打一次 LLM；
# 環境偏慢時請再加大本值。
# 相容性：舊版允許「恰等於」，AI_DEDUPE_LOCK_SECONDS=30 + AI_TIMEOUT_MS=30000 的舊設定現在會拒絕啟動，需改為 ≥ 35。
AI_DEDUPE_LOCK_SECONDS=45
# 單次 AI streaming 逾時（毫秒）——逾時以 AbortSignal 真正中止串流，依重試策略處理（最終嘗試才送 ai/error）
AI_TIMEOUT_MS=30000
# 單次輸出 token 上限（Gemini maxOutputTokens，正整數、≤ 65536，預設 2048）。診斷 JSON 約數百 token；
# 設上限是讓 JSON mode 偶發的重複輸出由供應商截斷收尾，而非拖到 AI_TIMEOUT_MS。被截斷
# （finishReason=max_tokens）視為不可重試的 schema_invalid，第一次就通知前端。
# thinking token 也計入此上限：換成不能關 thinking 的模型（如 gemini-2.5-pro、gemini-3.x）時需調高至 ≥ 8192
# （低於此值時 worker 啟動會 warn）。
# 本值不進快取簽章：改值後 AI_CACHE_TTL_SECONDS 內同一簽章仍會命中舊結果（要立即生效需等快取過期或清 cache）。
AI_MAX_OUTPUT_TOKENS=2048
# 取樣溫度（0–2，可為小數，預設 0.2）：結構化診斷要穩定可重現，建議維持偏低。
# 本值不進快取簽章：改值後 AI_CACHE_TTL_SECONDS 內同一簽章仍會命中舊結果。
AI_TEMPERATURE=0.2

# ---- AI provider 選擇（測試替身；預設 gemini）----
# AI_PROVIDER：gemini（預設，正式唯一 provider）| fake（測試替身：不呼叫 LLM、不需金鑰，
#   輸出固定的假診斷並以下列延遲逐段串流；仍經 DiagnosisResultSchema 驗證、照常進 cache 與 Pub/Sub）。
#   ⚠ fake 僅供跨 process e2e（tests/e2e，由 docker-compose.e2e.yml 注入）與演練；
#   NODE_ENV=production 下仍允許（不會崩潰），但啟動時記一則 warn——正式環境 MUST 留空或設 gemini。
#   非法值（例如 openai）啟動即 exit 1。
AI_PROVIDER=
# fake 專用（gemini 時不作用）：相鄰 token 延遲（毫秒，0–60000，預設 500）與切段數（1–1000，預設 20；
# 超過假診斷 JSON 字元數時以字元數為上限）。
# 預設約 10 秒串流，足以在 e2e 中途 kill worker；(段數 − 1) × 延遲 ≥ AI_TIMEOUT_MS 時啟動會 warn（每筆都會逾時）。
FAKE_AI_TOKEN_DELAY_MS=
FAKE_AI_TOKENS=

# ---- Feature 009：可觀測性基線 ----
# 根 logger 等級；未設定或收到無法辨識的值一律回退 info，並記一則 warn 說明實際採用值（FR-003）。
LOG_LEVEL=info
# 是否 pretty-print；留空時由 NODE_ENV 推導（非 production 預設 pretty，production 預設純 JSON）。
# 顯式設 true/false 可覆寫推導值——但**只對本機直跑有效**：pretty 需要 pino-pretty，該套件是
# devDependency、不隨映像部署，故 docker-compose.yml 於 worker 的 environment 釘死
# LOG_PRETTY=false（environment 優先於 env_file）。此處設 true 不會讓容器崩潰，也不會生效。
LOG_PRETTY=
# 指標摘要輸出間隔（毫秒），MUST 與 apps/api 的 METRICS_INTERVAL_MS 設同一個值——
# worker 依此週期把自己那半寫入 Redis metrics:worker:<實例 id>，api 依同週期讀取合併（下限 5000ms，FR-008）。
METRICS_INTERVAL_MS=60000
# 指標摘要專屬日誌等級，獨立於 LOG_LEVEL——即使 LOG_LEVEL 調到 warn，指標摘要仍可見（SC-005）。
METRICS_LOG_LEVEL=info

# ---- 故障注入（007 supervision；僅供故障演練，預設 MUST 關閉）----
# 用途：可重現演練「致命 → 監督者重啟 → 恢復消化」，不改 code、不重建 image。
# WORKER_CHAOS：注入的致命錯誤型態。合法值：uncaught（未捕捉例外）| rejection（未處理拒絕）。
#   未設定或留空＝關閉（零影響）；非法值會記 warn 後視為關閉。
# WORKER_CHAOS_AT：注入時點。合法值：startup（bootstrap 後約 2 秒，供崩潰迴圈演練）
#   | job（下一筆 job 處理中拋出，供進行中工作重派演練）。預設 startup。
# WORKER_CHAOS_ALLOW_IN_PRODUCTION：NODE_ENV=production 時（worker 容器 image 固定如此）chaos 預設一律
#   忽略；設 true 才放行，供一鍵 demo 容器內演練。合法值 true|false，預設 false，非法值 warn 後視為 false。
#   本機直跑（NODE_ENV 未設或 development）不需要此開關。
# 演練步驟見 specs/007-worker-process-supervision/quickstart.md 場景 3/4。
# ⚠ 演練結束務必移除／清空這三個變數再重啟（demo 前也務必確認未設定）。
WORKER_CHAOS=
WORKER_CHAOS_AT=
WORKER_CHAOS_ALLOW_IN_PRODUCTION=
