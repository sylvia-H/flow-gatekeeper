# apps/worker/.env.example
# 複製為 apps/worker/.env 後填值：  Copy-Item apps/worker/.env.example apps/worker/.env
# apps/worker/.env 已被 .gitignore 忽略，勿提交（憲章硬規則 7：只提交 .env.example）。
#
# 這支 process = 獨立的 BullMQ consumer：讀 Mongo 組 context → 查 Redis 快取 →
# 取去重鎖 → 呼叫 Gemini streaming → schema 驗證 → 寫 Mongo/快取 → 經 Pub/Sub relay 回 Gateway。
# worker 用 dotenv/config 以「執行時 cwd（apps/worker）」載入本層 .env。
# worker 是唯一呼叫 LLM 的 process，GEMINI_API_KEY 只需放在這裡。

# ---- Redis：BullMQ consumer、cache-aside、dedupe lock、Pub/Sub ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MongoDB：讀近期遙測/errorlogs/maintenance 組 context；寫最終 diagnoses ----
MONGO_URL=mongodb://127.0.0.1:27017/flow-gatekeeper
MONGO_DB=flow-gatekeeper

# ---- AI provider（Gemini，包在 AiProvider interface 後）----
# 申請一組 Gemini API key 貼在等號後（不要引號、不要空白）。
# 連通性可先用 pnpm --filter worker smoke:gemini 驗證。
#
# 留空的行為（刻意設計，非缺陷）：
#   症狀——全棧仍照常啟動，遙測與背壓比值正常（4 個賣點中的 2 個仍可見）；僅 AI 診斷失敗，
#         畫面訊息會「指名金鑰」（AI 服務金鑰無效或未授權——請確認本檔的 GEMINI_API_KEY…）。
#   成因——本專案刻意不把缺金鑰升級為啟動失敗，讓沒有 Gemini 帳號的評估者仍看得到系統跑起來，
#         而非一個賣點都看不到。技術上是走既有的 ai/error 路徑（不新增任何啟動前祕密檢查）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 每分鐘實際 LLM 呼叫上限（BullMQ limiter；與 concurrency 為獨立維度）
AI_RPM=8
# 診斷快取有效期（秒）
AI_CACHE_TTL_SECONDS=600
# 同簽章去重鎖有效期（秒）——持鎖者逾時/崩潰後可放行重算
AI_DEDUPE_LOCK_SECONDS=45
# 單次 AI streaming 應用層逾時（毫秒）——逾時轉 ai/error 並依重試策略處理
AI_TIMEOUT_MS=30000

# ---- Feature 009：可觀測性基線 ----
# 根 logger 等級；未設定或收到無法辨識的值一律回退 info，並記一則 warn 說明實際採用值（FR-003）。
LOG_LEVEL=info
# 是否 pretty-print；留空時由 NODE_ENV 推導（非 production 預設 pretty，production 預設純 JSON）。
# 顯式設 true/false 可覆寫推導值。
LOG_PRETTY=
# 指標摘要輸出間隔（毫秒），MUST 與 apps/api 的 METRICS_INTERVAL_MS 設同一個值——
# worker 依此週期把自己那半寫入 Redis metrics:worker，api 依同週期讀取合併（下限 5000ms，FR-008）。
METRICS_INTERVAL_MS=60000
# 指標摘要專屬日誌等級，獨立於 LOG_LEVEL——即使 LOG_LEVEL 調到 warn，指標摘要仍可見（SC-005）。
METRICS_LOG_LEVEL=info

# ---- 故障注入（007 supervision；僅供故障演練，預設 MUST 關閉）----
# 用途：可重現演練「致命 → 監督者重啟 → 恢復消化」，不改 code、不重建 image。
# WORKER_CHAOS：注入的致命錯誤型態。合法值：uncaught（未捕捉例外）| rejection（未處理拒絕）。
#   未設定或留空＝關閉（零影響）；非法值會記 warn 後視為關閉。
# WORKER_CHAOS_AT：注入時點。合法值：startup（bootstrap 後約 2 秒，供崩潰迴圈演練）
#   | job（下一筆 job 處理中拋出，供進行中工作重派演練）。預設 startup。
# 演練步驟見 specs/007-worker-process-supervision/quickstart.md 場景 3/4。
# ⚠ 演練結束務必移除／清空這兩個變數再重啟（demo 前也務必確認未設定）。
WORKER_CHAOS=
WORKER_CHAOS_AT=
