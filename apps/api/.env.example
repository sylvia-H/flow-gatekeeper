# apps/api/.env.example
# 複製為 apps/api/.env 後填值：  Copy-Item apps/api/.env.example apps/api/.env
# apps/api/.env 已被 .gitignore 忽略，勿提交（憲章硬規則 7：只提交 .env.example）。
#
# 這支 process = NestJS API + WebSocket Gateway + mock telemetry producer + POST /diagnoses。
# api 由 src/main.ts 明確載入「本檔同層」的 .env（不是根目錄）。
# api 不呼叫 LLM，故這裡不需要 GEMINI_API_KEY（那是 worker 的事）。
#
# 啟動時驗證：API_PORT／REDIS_PORT／WS_HEARTBEAT_MS／MOCK_TELEMETRY_INTERVAL_MS／
# TELEMETRY_TTL_SECONDS／WS_SEND_HIGH_WATER_BYTES／MAX_WS_CONNECTIONS／WS_AUTH_GRACE_MS 留空＝套用預設；
# 設成 0、負數、小數、非數字或超出範圍，api 會列出錯誤並拒絕啟動。
# 兩個計時器間隔另有下限與上限（2147483647，超過 Node 計時器會退化成每 1ms 觸發）：
# WS_HEARTBEAT_MS ≥ 1000、MOCK_TELEMETRY_INTERVAL_MS ≥ 5，超出範圍同樣拒絕啟動。

# ---- API ----
API_PORT=3000

# ---- Redis：BullMQ producer、job-status / AI relay、health、metrics（連線分離，憲章 IV）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis requirepass；留空＝未啟用密碼。api 與 worker 皆讀取，兩邊必須設同一個值——
# 只設一邊，另一邊的連線會全部 NOAUTH、無限重連。
# redis 伺服端是否啟用認證由 compose 決定（讀 host shell 或 repo 根 .env 的 REDIS_PASSWORD）——
# 開發模式三處一致：根 .env／shell、本檔、apps/worker/.env（demo 則為 apps/api/.env.demo）。
REDIS_PASSWORD=

# ---- MongoDB：遙測時序歷史 / errorlogs / maintenanceRecords / diagnoses ----
# 資料庫名以 MONGO_DB 為準（MONGO_URL 路徑中的 db 名不會被用來選庫）；須與 apps/worker/.env 一致。
MONGO_URL=mongodb://127.0.0.1:27017/flow-gatekeeper
MONGO_DB=flow-gatekeeper

# ---- WebSocket ----
# 本機 live 驗收：留空。前端 subscribe 送空 token，Gateway 僅在「有設密鑰時」才驗證；
# 留空即等於 dev 開放訂閱（見 specs/004-frontend-ws-gatekeeper/research.md R3、README「環境變數」表 WS_AUTH_SECRET 列）。
WS_AUTH_SECRET=
# 設了密鑰時，只有通過 machine/subscribe token 檢查的連線才算「已授權」：AI 串流、job/status、
# system/metrics 只送已授權連線，POST /diagnoses 的 socketId 不在線或未授權一律回 409。
# 同一連線錯誤 token／畸形訊息累計 10 次即以 close code 1008 關閉。
# 授權失敗等同類 warn 以 30 秒抽樣記錄（附被壓掉的則數），不是逐則記錄。
# 心跳 sweep 間隔（毫秒）；下限 1000——更短會把稍慢回 pong 的正常連線誤判為死連線。
# 伺服器每輪送帶隨機 nonce 的 ping，pong 必須原樣帶回才算存活（瀏覽器與 ws 套件會自動處理）。
WS_HEARTBEAT_MS=15000
# 單一連線送出緩衝高水位（bytes），預設 1048576（1 MiB），範圍 65536–268435456。
# 對端讀不動、緩衝超過此值時略過該筆推送；連續 3 個心跳 tick 仍超標即 terminate 該連線。
WS_SEND_HIGH_WATER_BYTES=1048576
# WS 同時連線數上限，預設 500，範圍 1–100000；已達上限的 upgrade 以 HTTP 503 拒絕。
MAX_WS_CONNECTIONS=500
# 有設 WS_AUTH_SECRET 時，連線須在此期限（毫秒）內通過 machine/subscribe token 檢查，否則以
# close code 1008 關閉（防止連上不訂閱的 client 佔滿連線名額）。預設 10000，範圍 1000–60000；
# 由獨立授權 sweep 檢查（間隔 min(WS_HEARTBEAT_MS, 本值)），實際關閉時間 ≤ 本值 + 該間隔。未設密鑰時不適用；
# 另有未授權連線子上限 max(10, floor(MAX_WS_CONNECTIONS × 0.2))，達上限的 upgrade 回 503（限制未授權者可佔的總名額；
# 持 token 的新連線同樣先經過未授權池，池滿時一樣 503）。逾期不回 close frame 者再過一個期限即 terminate。
WS_AUTH_GRACE_MS=10000

# ---- Telemetry mock producer ----
# 預設 50ms（10–50ms 量級）。調小節拍會放大背壓比值（最小 5，更小拒絕啟動）；比值隨節拍、機台數與
# 瀏覽器幀率變化，不是固定規格。
MOCK_TELEMETRY_INTERVAL_MS=50

# ---- Data lifecycle ----
# 時序遙測保存期；本機 demo 可調小（如 3600 = 1 小時），spec 預設 604800（7 天），逾期自動清理。
TELEMETRY_TTL_SECONDS=604800

# ---- Feature 009：可觀測性基線 ----
# 根 logger 等級；未設定或收到無法辨識的值一律回退 info，並記一則 warn 說明實際採用值（FR-003）。
LOG_LEVEL=info
# 是否 pretty-print；留空時由 NODE_ENV 推導（非 production 預設 pretty，production 預設純 JSON）。
# 顯式設 true/false 可覆寫推導值。
LOG_PRETTY=
# 指標摘要輸出間隔（毫秒）。須為 5000–2147483647 的整數；非整數（如 5000.5）、低於下限或超過上限
# 的設定值回退預設 60000 並記一則 warn（不是 clamp、不拒絕啟動，FR-008）。
METRICS_INTERVAL_MS=60000
# 指標摘要專屬日誌等級，獨立於 LOG_LEVEL——即使 LOG_LEVEL 調到 warn，指標摘要仍可見（SC-005）。
METRICS_LOG_LEVEL=info
# GET /healthz 對 Redis/Mongo 逐一探測的逾時（毫秒）；逾時視為該依賴 down，不阻塞回應（FR-007）。
HEALTH_PROBE_TIMEOUT_MS=2000

# ---- WebSocket Origin 白名單（防 Cross-Site WebSocket Hijacking）----
# 逗號分隔的允許 Origin，例如 http://localhost:5173,https://demo.example.com。
# 不要寫預設 port（瀏覽器送出的 Origin 會省略 :80／:443，寫了反而比對不到）。
# 留空＝不檢查（demo 經 nginx 同源對外時即可留空）。沒有 Origin header 的非瀏覽器 client
# （smoke 腳本、CLI）一律放行；有 Origin 但不在清單內的 upgrade 以 403 拒絕。
WS_ALLOWED_ORIGINS=
