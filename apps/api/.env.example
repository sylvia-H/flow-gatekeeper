# apps/api/.env.example
# 複製為 apps/api/.env 後填值：  Copy-Item apps/api/.env.example apps/api/.env
# apps/api/.env 已被 .gitignore 忽略，勿提交（憲章硬規則 7：只提交 .env.example）。
#
# 這支 process = NestJS API + WebSocket Gateway + mock telemetry producer + POST /diagnoses。
# api 由 src/main.ts 明確載入「本檔同層」的 .env（不是根目錄）。
# api 不呼叫 LLM，故這裡不需要 GEMINI_API_KEY（那是 worker 的事）。

# ---- API ----
API_PORT=3000

# ---- Redis：BullMQ producer、job-status / AI relay（連線分離，憲章 IV）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MongoDB：遙測時序歷史 / errorlogs / maintenanceRecords / diagnoses ----
MONGO_URL=mongodb://127.0.0.1:27017/flow-gatekeeper
MONGO_DB=flow-gatekeeper

# ---- WebSocket ----
# 本機 live 驗收：留空。前端 subscribe 送空 token，Gateway 僅在「有設密鑰時」才驗證；
# 留空即等於 dev 開放訂閱（見 memory live-acceptance-recipe / 004 research R3）。
WS_AUTH_SECRET=
WS_HEARTBEAT_MS=15000

# ---- Telemetry mock producer ----
# 預設 50ms（10–50ms 量級）。demo 想放大背壓比值（≥10:1）可調到 5。
MOCK_TELEMETRY_INTERVAL_MS=50

# ---- Data lifecycle ----
# 時序遙測保存期；本機 demo 可調小（如 3600 = 1 小時），spec 預設 604800（7 天），逾期自動清理。
TELEMETRY_TTL_SECONDS=604800
