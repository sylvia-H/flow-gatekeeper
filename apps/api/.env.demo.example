# apps/api/.env.demo.example — 全棧 demo（docker compose --profile demo）專用的 api env 範本
# 複製為 apps/api/.env.demo 後即可啟動：  Copy-Item apps/api/.env.demo.example apps/api/.env.demo
# apps/api/.env.demo 已被 .gitignore 忽略，勿提交（憲章硬規則 7：只提交 .example）。
#
# 為什麼與 apps/api/.env（開發者 dev env）分開：dev .env 可能設了非空 WS_AUTH_SECRET 或改了
# API_PORT，若 demo 直接沿用會把這些 dev 值滲進容器——症狀是「容器 healthy 但 web 的遙測/背壓
# 兩個賣點靜默消失」（前端不帶 token 被拒訂閱），極難診斷。本檔為 demo 隔離出乾淨的一份設定。
#
# 注意：REDIS_HOST／MONGO_URL／API_PORT 這些「拓樸關鍵值」由 docker-compose.yml 的 environment
# 覆蓋釘死（服務彼此的容器名、nginx 硬編轉發的 api:3000），故本檔即使被改也不影響那三項；本檔真正
# 負責的是 app 層設定，尤以 WS_AUTH_SECRET 留空為 demo 連得上的關鍵。

# ---- API ----
# 由 compose environment 釘為 3000（與 nginx 反代目標 api:3000 對齊）；此處僅記錄形狀。
API_PORT=3000

# ---- Redis：BullMQ producer、job-status / AI relay ----
# REDIS_HOST 由 compose environment 覆蓋為容器名 redis；此處僅記錄形狀。
REDIS_HOST=redis
REDIS_PORT=6379
# Redis requirepass；留空＝未啟用密碼。api 與 worker 皆讀取，兩邊必須設同一個值。
REDIS_PASSWORD=

# ---- MongoDB ----
# MONGO_URL 由 compose environment 覆蓋為 mongodb://mongo:27017/...；此處僅記錄形狀。
MONGO_URL=mongodb://mongo:27017/flow-gatekeeper
MONGO_DB=flow-gatekeeper

# ---- WebSocket ----
# demo 一律留空：Gateway 僅在「有設密鑰時」才驗證 subscribe，留空即開放訂閱，
# 前端送空 token 也連得上（見 memory live-acceptance-recipe / 004 research R3）。
WS_AUTH_SECRET=
WS_HEARTBEAT_MS=15000
# WS upgrade 的 Origin 白名單（逗號分隔，例如 https://demo.example.com）；防跨站 WebSocket 劫持。
# 留空＝不檢查：demo 經 nginx 同源對外，瀏覽器帶的 Origin 就是自己。若對外網域不是同源存取，
# 填入瀏覽器網址列上實際的 scheme://host[:port]。
WS_ALLOWED_ORIGINS=

# ---- Telemetry mock producer ----
# demo 想放大背壓比值（≥10:1）可調到 5。
MOCK_TELEMETRY_INTERVAL_MS=50

# ---- Data lifecycle ----
TELEMETRY_TTL_SECONDS=604800
